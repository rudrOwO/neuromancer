#!/bin/sh
# pre-push hook: prompt for version bump before pushing

exec </dev/tty

echo "Choose version bump: [p]atch or [m]inor? (enter to skip)"
read BUMP_CHOICE

case "$BUMP_CHOICE" in
"")
  echo "No version bump performed."
  exit 0
  ;;
m | M)
  BUMP_TYPE="minor"
  ;;
p | P)
  BUMP_TYPE="patch"
  ;;
*)
  # Assume user typed a full version like 1.2.3
  if echo "$BUMP_CHOICE" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    BUMP_TYPE="$BUMP_CHOICE"
  else
    echo "Invalid choice. Use [m]inor, [p]atch, or a version number (e.g. 1.2.3)."
    exit 1
  fi
  ;;
esac

echo "Performing a $BUMP_TYPE version bump..."

npm version "$BUMP_TYPE"

if [ $? -ne 0 ]; then
  echo "npm version command failed. Aborting push."
  exit 1
fi

exit 0
